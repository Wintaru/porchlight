# Porchlight environment. Copy to .env.local in apps/web (Next.js reads it there).
# Every value has a local default or a fake mode, so a fresh clone runs with no vendor
# keys (D19). One guide per external service lives in docs/setup/.

# NODE_ENV=production refuses every *_PROVIDER=fake below at startup (D19): a deployment
# never runs a scanning or storage provider's fake silently. ALLOW_FAKE_PROVIDERS=1 lifts
# that refusal for one deliberate, degraded production run — the admin settings page's
# duty checklist (/admin) then shows that provider red, "not yet active", so the choice
# stays visible. Leave unset; only ever set it on purpose (SPEC.md §7, issue #12).
ALLOW_FAKE_PROVIDERS=

# --- Site ---------------------------------------------------------------------------
# Public origin of this deployment. Used for canonical URLs, sitemap, RSS and OAuth
# redirects. Local: the Next.js dev server.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Region, and every other D20 setting, lives in `site_config` and is set from the admin
# settings page (/admin), not from the environment (SPEC.md §4, §7, issue #12) — there is
# no PORCHLIGHT_REGION variable to set here. `SITE_CONFIG_PROVIDER` below only chooses
# supabase vs. the in-memory fake for that store.

# --- Supabase (docs/setup/supabase.md) ------------------------------------------------
# `supabase start` prints these. The values below are the fixed local-stack ones, the
# same on every machine, so a fresh clone runs unchanged. Porchlight's stack sits on the
# 583xx port block (supabase/config.toml). The anon key is public by design and lands in
# the browser. The service-role key bypasses RLS: server only, never NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:58321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
# Direct Postgres URL for migrations, the seed, and the packages/db tests.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:58322/postgres

# --- Sign-in (docs/setup/google-oauth.md) ---------------------------------------------
# Google OAuth through Supabase Auth is the one production sign-in (SPEC.md §4). The
# local Supabase config reads these two from the shell environment or from
# supabase/.env.local, not from this file. Empty means the Google button fails at
# Google and the dev sign-in below covers local work.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
# The dev-only sign-in page /auth/dev-sign-in: a password sign-in as a seeded member
# (docs/setup/supabase.md) with no Google. `on` or `off`. A production build ignores it.
AUTH_DEV_SIGN_IN=on
# This email becomes admin on its first sign-in, and no other account does. Empty
# means only the first profile ever is admin. Case-insensitive.
PORCHLIGHT_ADMIN_EMAIL=
# The profile store behind AccountManager: supabase (default, needs the two Supabase
# keys above) | fake (in-memory, tests only).
PROFILE_PROVIDER=supabase

# --- Posts and site settings (SPEC.md §5, §4) -----------------------------------------
# The post store behind PostManager and the site_config store behind the
# PermissionEngine's D20 checks: supabase (default) | fake (in-memory, tests only).
# Each fake has a *_FAKE_RESULT of ok | fail. SITE_CONFIG_FAKE_POSTING sets the fake's
# `posting` key (anyone | members | staff), SITE_CONFIG_FAKE_COMMENTS its `comments` key
# (anyone | members | off), and SITE_CONFIG_FAKE_SIGN_UP its `sign_up` key (open | invite
# | closed), so a test can close writing or sign-up without a row. The comment store
# behind CommentManager and the reaction store take the same two knobs.
POST_PROVIDER=supabase
POST_FAKE_RESULT=ok
COMMENT_PROVIDER=supabase
COMMENT_FAKE_RESULT=ok
REACTION_PROVIDER=supabase
REACTION_FAKE_RESULT=ok
SITE_CONFIG_PROVIDER=supabase
SITE_CONFIG_FAKE_RESULT=ok
SITE_CONFIG_FAKE_POSTING=anyone
SITE_CONFIG_FAKE_COMMENTS=anyone
SITE_CONFIG_FAKE_SIGN_UP=open

# --- Cloudflare Turnstile (docs/setup/turnstile.md) -----------------------------------
# Guards every anonymous submit (D15). Empty keys select the fake provider, which
# reports `pass` unless TURNSTILE_FAKE_RESULT says otherwise.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Fake provider result: pass | fail
TURNSTILE_FAKE_RESULT=pass

# --- Anonymous writing (SPEC.md §4, issue #8) ------------------------------------------
# The anonymous-author, block-list and rate-limit stores behind the D15 admission guard:
# supabase (default) | fake (in-memory, tests only). Each fake has a *_FAKE_RESULT of
# ok | fail. Limits are per-hour fixed windows; unset keeps the defaults (30 per IP, 15
# per anonymous token).
ANONYMOUS_AUTHOR_PROVIDER=supabase
ANONYMOUS_AUTHOR_FAKE_RESULT=ok
BLOCK_PROVIDER=supabase
BLOCK_FAKE_RESULT=ok
RATE_LIMIT_PROVIDER=supabase
RATE_LIMIT_FAKE_RESULT=ok
ANONYMOUS_LIMIT_PER_IP_PER_HOUR=30
ANONYMOUS_LIMIT_PER_TOKEN_PER_HOUR=15
# `true` only behind a reverse proxy that overwrites or strips a client-supplied
# X-Forwarded-For before appending its own (docs/setup/turnstile.md). Left unset, every
# anonymous visitor shares one IP bucket for the block list and the rate limit — safe,
# but not per-visitor. Never `true` with the app exposed directly to the internet: a
# flood would spoof a fresh identity on every request and skip both guards.
TRUST_FORWARDED_FOR=false

# --- Greeting example (packages/core, issue #2) ---------------------------------------
# The worked example of the fake-provider pattern behind GET/POST /api/greeting. The
# moderation accessors below use the same two knobs. Provider: fake. Fake result:
# ok | fail (fail answers 503 so the error path can be seen without an outage).
GREETING_PROVIDER=fake
GREETING_FAKE_RESULT=ok

# --- Storage (docs/setup/storage.md) --------------------------------------------------
# Phase 1 stores uploads in Supabase Storage behind MediaStorageAccessor (D4).
STORAGE_BUCKET_QUARANTINE=quarantine
STORAGE_BUCKET_PUBLIC=public-media
# The media_assets store, the storage-signing store, and a member's running quota, each
# behind the same fake-provider pattern as every other accessor: supabase (default) |
# fake (in-memory, tests only). Each fake has a *_FAKE_RESULT of ok | fail.
MEDIA_PROVIDER=supabase
MEDIA_FAKE_RESULT=ok
MEDIA_STORAGE_PROVIDER=supabase
MEDIA_STORAGE_FAKE_RESULT=ok
QUOTA_PROVIDER=supabase
QUOTA_FAKE_RESULT=ok

# --- Hash matching (docs/setup/hash-matching.md) --------------------------------------
# Provider: fake | arachnid-shield | photodna. Fake is the default until Shield access
# is approved (D17b). HASH_MATCH_FAKE_RESULT: clear | match | fail.
HASH_MATCH_PROVIDER=fake
HASH_MATCH_API_KEY=
HASH_MATCH_FAKE_RESULT=clear

# --- Image classifier (docs/setup/classifiers.md) -------------------------------------
# Provider: fake | hive | sightengine. Purpose-built image models only; a general LLM
# API never receives an image (SPEC.md §7). IMAGE_CLASSIFIER_FAKE_RESULT: clear |
# flagged | locked | fail.
IMAGE_CLASSIFIER_PROVIDER=fake
IMAGE_CLASSIFIER_API_KEY=
IMAGE_CLASSIFIER_FAKE_RESULT=clear

# --- Text moderation (docs/setup/classifiers.md) --------------------------------------
# Provider: fake | openai | anthropic. Text only. TEXT_MODERATION_FAKE_RESULT: clear |
# flagged | fail.
TEXT_MODERATION_PROVIDER=fake
TEXT_MODERATION_API_KEY=
TEXT_MODERATION_FAKE_RESULT=clear

# --- Email, phase 2 (docs/setup/email.md) ---------------------------------------------
# Provider: fake | resend | ses. The fake provider writes messages to the server log.
EMAIL_PROVIDER=fake
EMAIL_API_KEY=
EMAIL_FROM=porchlight@localhost

# --- Evidence and retention (SPEC.md §7) ----------------------------------------------
# Salt for the IP hash kept after raw IPs are nulled. Generate once per deployment and
# never rotate, or old hashes stop matching blocks.
EVIDENCE_IP_HASH_SALT=change-me-locally
# Days to keep raw IP and port before nulling them. Region sets the default.
EVIDENCE_RAW_IP_RETENTION_DAYS=90
# The store behind a post's and a comment's evidence row (issue #61), the same
# fake-provider pattern as every other accessor: supabase (default) | fake (tests only).
EVIDENCE_PROVIDER=supabase
EVIDENCE_FAKE_RESULT=ok

# --- Moderation (SPEC.md §7, issue #11) ------------------------------------------------
# The reports, mod_actions and audit_log stores, each behind the same fake-provider
# pattern as every other accessor: supabase (default) | fake (in-memory, tests only).
REPORT_PROVIDER=supabase
REPORT_FAKE_RESULT=ok
MOD_ACTION_PROVIDER=supabase
MOD_ACTION_FAKE_RESULT=ok
AUDIT_PROVIDER=supabase
AUDIT_FAKE_RESULT=ok

# --- Notifications (SPEC.md §8, issue #13) ---------------------------------------------
NOTIFICATION_PROVIDER=supabase
NOTIFICATION_FAKE_RESULT=ok

# --- Agent tokens (SPEC.md §17, issue #27) ---------------------------------------------
# The store behind a member's personal MCP tokens, the same fake-provider pattern as
# every other accessor: supabase (default) | fake (in-memory, tests only). Who may mint
# one is `site_config.agents` (members | staff | off), set from /admin, not here.
AGENT_TOKEN_PROVIDER=supabase
AGENT_TOKEN_FAKE_RESULT=ok
# The MCP door is /api/mcp on this same origin (docs/agents.md). No key: an agent
# authenticates with a member's personal token. Daily caps per token live in
# `site_config.agent_limits`, not here.
